# OpenAI-compatible provider configuration for CFDC.
# Replace all three values for the provider/model you actually use.
CFDC_LLM_BASE_URL=https://your-provider.example
CFDC_LLM_MODEL=your-provider-model
CFDC_LLM_API_KEY=your-provider-api-key

# Optional server-side storage override for the WebUI-managed built-in index.
# Blank defaults to output/rag-index. This path is never exposed in the WebUI.
CFDC_RAG_INDEX_DIR=

# Optional request settings are CLI flags:
#   --llm-timeout-s 60
#   --llm-max-tokens 1400
