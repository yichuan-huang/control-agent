# OpenAI-compatible provider configuration for CFDC.
# Fill all three values in your local .env; never commit or share that file.
# Example Base URL for DeepSeek: https://api.deepseek.com
# Use your provider's exact model identifier. Quote values containing $ or #
# with single quotes to keep them literal in Docker Compose.
CFDC_LLM_BASE_URL=
CFDC_LLM_MODEL=
CFDC_LLM_API_KEY=

# Live validation: bash scripts/test_live_llm.sh service|browser|all
# Ordinary tests and CI do not consume these credentials or enable inference.

# Optional server-side storage override for the WebUI-managed built-in index.
# Blank defaults to output/rag-index. This path is never exposed in the WebUI.
CFDC_RAG_INDEX_DIR=

# Optional request settings are CLI flags:
#   --llm-timeout-s 60
#   --llm-max-tokens 1400
