        "operating_region": "归一化泵速 -1 至 1；局部液位偏差绝对值不超过 1.5",
        "input_min": -1.0, "input_max": 1.0, "state_stop": 3.0,
        "response_time_preference_s": 14.0, "final_abs_error_max": 0.05, "overshoot_max": 0.15, "settling_time_max_s": 14.0, "perturbed_success_rate_min": 0.8,
