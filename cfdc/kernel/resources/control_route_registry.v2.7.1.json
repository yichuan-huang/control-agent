    "lead_lag_series": {
      "label_cn": "串联超前滞后动态补偿",
      "required_parameters": ["gain", "lead_zero_rate", "lead_pole_rate", "lag_zero_rate", "lag_pole_rate"],
      "controller_features": ["velocity_gain", "slow_lag_rate", "fast_lag_rate"],
      "optional_controller_features": [],
      "route_guard_features": [],
      "runtime_contract": {
        "version": "1.0.0",
        "form": "proper_series_lead_lag_on_unity_feedback_error",
        "state_variables": ["lead_section_state", "lag_section_state"],
        "update_order": [
          "form tracking error from the public reference and measured output",
          "advance the stable lead section state using the recorded positive sample interval",
          "advance the stable lag section state from the lead-section output",
          "multiply the cascade output by the frozen gain",
          "clip the final command to the frozen actuator limits"
        ],
        "equations": {
          "lead_section": "v_lead=e+(z_lead-p_lead)*x_lead; dx_lead=-p_lead*x_lead+e",
          "lag_section": "v_lag=v_lead+(z_lag-p_lag)*x_lag; dx_lag=-p_lag*x_lag+v_lead",
          "raw_actuator": "u_raw=gain*v_lag",
          "actuator_command": "u=clip(u_raw,input_saturation)"
        },
        "parameter_ordering": "0 < lead_zero_rate < lead_pole_rate and 0 < lag_pole_rate <= lag_zero_rate",
        "anti_windup": "not_applicable_no_integrator",
        "time_base": "provider-recorded positive sample interval"
      }
    },
    "cascaded_control": {
      "label_cn": "局部不稳定内环 PD 加慢外环 PD",
      "required_parameters": ["inner_kp", "inner_kd", "inner_target_rate", "outer_target_rate", "outer_damping", "internal_reference_limit", "reference_acceleration_scale"],
      "controller_features": ["unstable_mode_rate", "angular_input_gain"],
      "optional_controller_features": [],
      "route_guard_features": ["sensing_actuation_adequacy", "control_authority"],
      "runtime_contract": {
        "version": "1.0.0",
        "form": "measured_internal_PD_with_bounded_outer_acceleration_reference",
        "state_variables": [],
        "update_order": [
          "compute outer desired acceleration from task position and velocity",
          "convert desired acceleration to a bounded internal-variable reference",
          "compute inner PD command from measured internal variable and rate",
          "clip the final actuator command to the frozen saturation"
        ],
        "equations": {
          "outer_desired_acceleration": "a_ref=outer_target_rate^2*(reference-position)-2*outer_damping*outer_target_rate*velocity",
          "internal_reference": "internal_ref=clip(-a_ref/reference_acceleration_scale,+/-internal_reference_limit)",
          "actuator_command": "u=clip(-inner_kp*(internal-internal_ref)-inner_kd*internal_rate,input_saturation)"
        },
        "anti_windup": "not_applicable_no_integrator",
        "time_base": "provider-recorded positive sample interval"
      }
    },
