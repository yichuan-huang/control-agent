        "form": "two_virtual_PI_channels_through_DC_preserving_stable_lag_input_map",
        "state_variables": ["integral_error_1", "integral_error_2", "three_two_channel_lag_states"],
        "update_order": [
          "form candidate integral states from both output errors and recorded dt",
          "form both virtual PI commands using the candidate integrals",
          "advance each stable lag state toward the virtual command using recorded dt",
          "apply the DC base map plus lag corrections to the virtual commands",
          "clip both actuator commands to the frozen saturation",
          "commit both candidate integrals only when neither raw actuator command is saturated"
        ],
        "equations": {
          "candidate_integral": "I_candidate=I+error*dt",
          "virtual_command": "v=kp*error+ki*I_candidate",
          "lag_update": "z_k=z_k+dt*(v-z_k)/dynamic_filter_tau_k",
          "raw_actuator": "u_raw=D_base*v+sum_k(D_lag_k*(z_k-v))",
          "actuator_command": "u=clip(u_raw,input_saturation)"
        },
