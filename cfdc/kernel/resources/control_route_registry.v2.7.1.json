          "form and clip the fixed PID actuator command using measured velocity and the current integral state",
          "advance the integral state with frozen back-calculation anti-windup"
        ],
        "equations": {
          "raw_actuator": "u_raw=feedforward*reference+kp*(reference-position)+integral_error-kd*velocity",
