    "scheduled_damping_PID": {
      "label_cn": "阻尼调度 PID",
      "required_parameters": ["kp", "ki", "kd", "feedforward", "input_gain_estimate", "base_decay", "quadratic_decay", "desired_damping", "target_bandwidth", "antiwindup_gain"],
      "controller_features": ["modal_frequency", "input_gain", "base_decay_rate", "quadratic_decay_rate"],
      "optional_controller_features": [],
