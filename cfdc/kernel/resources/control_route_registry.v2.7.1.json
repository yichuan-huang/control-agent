      "runtime_contract": {
        "version": "1.0.0",
        "form": "measured_state_PID_with_positive_region_amplitude_dependent_damping_schedule",
        "state_variables": ["integral_error"],
        "update_order": [
          "compute position error from the frozen reference and measured position",
          "estimate local plant decay from the frozen base and quadratic decay coefficients",
          "compute a nonnegative scheduled derivative gain from measured position",
          "form and clip the actuator command using the current integral state",
          "advance the integral state with frozen back-calculation anti-windup"
        ],
        "equations": {
          "plant_decay": "d_hat=base_decay+quadratic_decay*position^2",
          "scheduled_derivative": "kd_hat=max((2*desired_damping*target_bandwidth-2*d_hat)/input_gain_estimate,0)",
          "raw_actuator": "u_raw=feedforward*reference+kp*(reference-position)+integral_error-kd_hat*velocity",
          "actuator_command": "u=clip(u_raw,input_saturation)",
          "integral_update": "integral_error+=dt*(ki*(reference-position)+antiwindup_gain*(u-u_raw))"
        },
        "anti_windup": "back_calculation_with_frozen_gain",
        "time_base": "provider-recorded positive sample interval"
      }
    },
