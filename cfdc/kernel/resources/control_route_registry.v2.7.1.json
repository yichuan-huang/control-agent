{
  "registry_version": "2.7.1",
  "principles": [
    "The five classes are route-oriented dominant-structure families, not exhaustive plant identities.",
    "Class IV and V require a mechanism subtype before a controller can be authorized.",
    "A subtype is selected by observable evidence and deterministic analysis, never by benchmark case identity.",
    "Controller synthesis features, route guards, and diagnostic-only evidence are recorded separately.",
    "Unsupported subtypes end in an explicit capability gap; no neighboring controller is silently substituted."
  ],
  "controller_contracts": {
    "PI": {
      "label_cn": "比例积分控制",
      "required_parameters": ["kp", "ki", "reference_filter_rate"],
      "controller_features": ["static_gain", "dominant_time_constant"],
      "optional_controller_features": [],
      "route_guard_features": [],
      "runtime_contract": {
        "version": "1.0.0",
        "form": "filtered_reference_PI_on_measured_output_error",
        "state_variables": ["reference_filter_state", "integral_error"],
        "update_order": [
          "advance the reference filter using the recorded positive sample interval",
          "form tracking error from filtered reference and measured output",
          "form and clip the PI actuator command using the current integral state",
          "commit the error integral only when unsaturated or when the error drives the raw command back toward the admissible interval"
        ],
        "equations": {
          "reference_filter": "r_f+=dt*reference_filter_rate*(reference-r_f)",
          "raw_actuator": "u_raw=kp*(r_f-y)+ki*integral_error",
          "actuator_command": "u=clip(u_raw,input_saturation)",
          "integral_update": "integral_error+=dt*(r_f-y) only if abs(u_raw)<=limit or sign(r_f-y)!=sign(u_raw)"
        },
        "anti_windup": "conditional_integration",
        "time_base": "provider-recorded positive sample interval"
      }
    },
    "delay_aware_PI": {
      "label_cn": "延迟约束比例积分控制",
