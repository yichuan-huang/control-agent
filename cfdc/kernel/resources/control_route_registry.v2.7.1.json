        "time_base": "provider-recorded positive sample interval"
      }
    },
    "notch_then_PI": {
      "label_cn": "陷波器加比例积分控制",
      "required_parameters": ["kp", "ki", "reference_filter_rate", "notch_center_rad_s", "notch_zero_damping", "notch_pole_damping"],
      "controller_features": ["static_gain", "dominant_time_constant", "parasitic_mode_frequency"],
      "optional_controller_features": ["delay_bound"],
      "route_guard_features": ["fast_mode_presence"],
      "runtime_contract": {
        "version": "1.0.0",
        "form": "filtered_reference_PI_then_stable_notch",
        "state_variables": ["reference_filter_state", "integral_error", "notch_filter_state"],
        "update_order": [
          "advance the reference filter using the recorded positive sample interval",
          "form tracking error and the PI signal using the current integral state",
          "advance the stable notch state and form the notch-filtered raw actuator command",
          "clip the actuator command to the frozen saturation",
          "commit the error integral only when unsaturated or when the error drives the filtered raw command back toward the admissible interval"
        ],
        "equations": {
          "reference_filter": "r_f+=dt*reference_filter_rate*(reference-r_f)",
          "pi_signal": "v=kp*(r_f-y)+ki*integral_error",
          "notch_filter": "u_raw=notch(v;notch_center_rad_s,notch_zero_damping,notch_pole_damping)",
          "actuator_command": "u=clip(u_raw,input_saturation)",
          "integral_update": "integral_error+=dt*(r_f-y) only if abs(u_raw)<=limit or sign(r_f-y)!=sign(u_raw)"
        },
        "anti_windup": "conditional_integration_after_notch",
        "time_base": "provider-recorded positive sample interval"
      }
    },
    "two_dof_pid": {
      "label_cn": "参考前馈加两自由度 PID",
      "required_parameters": ["feedforward_gain", "kp", "ki", "kd", "reference_filter_rate", "derivative_filter_rate"],
      "controller_features": ["static_gain", "natural_frequency", "damping_ratio"],
      "optional_controller_features": [],
      "route_guard_features": [],
      "runtime_contract": {
        "version": "1.0.0",
        "form": "filtered_reference_feedforward_PID_with_filtered_output_derivative",
        "state_variables": ["reference_filter_state", "integral_error", "filtered_output_derivative", "previous_measured_output"],
        "update_order": [
          "advance the reference filter using the recorded positive sample interval",
          "estimate and low-pass filter the measured-output derivative",
          "form tracking error from filtered reference and measured output",
          "form and clip the feedforward PID actuator command",
          "commit the error integral only when unsaturated or when the error drives the raw command back toward the admissible interval"
        ],
        "equations": {
          "reference_filter": "r_f+=dt*reference_filter_rate*(reference-r_f)",
          "derivative_filter": "dy_f+=alpha*((y-y_previous)/dt-dy_f), alpha=1-exp(-derivative_filter_rate*dt)",
          "raw_actuator": "u_raw=feedforward_gain*r_f+kp*(r_f-y)+ki*integral_error-kd*dy_f",
          "actuator_command": "u=clip(u_raw,input_saturation)",
          "integral_update": "integral_error+=dt*(r_f-y) only if abs(u_raw)<=limit or sign(r_f-y)!=sign(u_raw)"
        },
        "anti_windup": "conditional_integration",
        "time_base": "provider-recorded positive sample interval"
      }
    },
